DTC_FLAGS := -@

dtb-$(CONFIG_ARCH_MXC) += som-imx8m-plus-headless.dtb

# hdmi
som-imx8m-plus-hdmi-dtbs := som-imx8m-plus-headless.dtb som-imx8m-plus-hdmi.dtbo
