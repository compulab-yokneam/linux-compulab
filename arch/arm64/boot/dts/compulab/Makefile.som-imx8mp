# all heads
som-imx8m-plus-dtbs := som-imx8m-plus-headless.dtb som-imx8m-plus-mipi.dtbo som-imx8m-plus-lvds.dtbo som-imx8m-plus-hdmi.dtbo
dtb-$(CONFIG_ARCH_MXC) += som-imx8m-plus.dtb

