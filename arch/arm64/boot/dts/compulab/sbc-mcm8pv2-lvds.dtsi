&{/} {
	sbc_lvds_backlight: backlight-lvds {
		compatible = "pwm-backlight";
		power-supply = <&sbc_5v0>;
		pwms = <&pwm2 0 50000 0>;
		brightness-levels = <0 16 32 64 96 128 160 192 224 255>;
		default-brightness-level = <8>;
	};
	/* Provisional panel; confirm the attached panel before deployment. */
	sbc_lvds_panel: panel-lvds {
		compatible = "boe,hv070wsa-100";
		power-supply = <&sbc_3v3>;
		enable-gpios = <&sbc_gpio 3 GPIO_ACTIVE_HIGH>;
		backlight = <&sbc_lvds_backlight>;

		port {
			sbc_lvds_in: endpoint {
				remote-endpoint = <&sbc_lvds_out>;
			};
		};
	};

	/* Keep touch reset deasserted, as on SBEV-UCMiMX8Plus. */
	sbc_ts_reset: regulator-tsreset {
		compatible = "regulator-fixed";
		regulator-name = "touch-reset";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&sbc_gpio 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&gpio4>;
		interrupts = <28 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_sbc_lvds_touch>;
		irq-gpios = <&gpio4 28 GPIO_ACTIVE_HIGH>;
		/* Reset is released by regulator-tsreset, matching the reference. */
		touchscreen-inverted-x;
		touchscreen-inverted-y;
		status = "okay";
	};
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_pwm2>;
	status = "okay";
};

&lcdif2 {
	status = "okay";
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	lvds-channel@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";

		port@1 {
			reg = <1>;
			sbc_lvds_out: endpoint {
				remote-endpoint = <&sbc_lvds_in>;
			};
		};
	};

	lvds-channel@1 {
		reg = <1>;
		status = "disabled";
	};
};

&ldb_phy {
	status = "okay";
};

&iomuxc {
	pinctrl_sbc_lvds_touch: sbc-lvds-touchgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI3_RXFS__GPIO4_IO28 0x19
		>;
	};

	pinctrl_sbc_pwm2: sbc-pwm2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SPDIF_RX__PWM2_OUT 0x116
		>;
	};
};
