# IOT-GATE-IMX8PLUS
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-usbdev.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-m2adc.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-m2emmc.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-m2m2.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-m2tpm.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-brkout_pwm_gpio.dtb
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-rpmsg.dtb
# falocn mode
dtb-$(CONFIG_ARCH_MXC) += mmc1_iot-gate-imx8plus-falcon.dtb
dtb-$(CONFIG_ARCH_MXC) += mmc2_iot-gate-imx8plus-falcon.dtb
# IOTDIN-IMX8P
dtb-$(CONFIG_ARCH_MXC) += iotdin-imx8p.dtb
dtb-$(CONFIG_ARCH_MXC) += iotdin-imx8p-rpmsg.dtb
dtb-$(CONFIG_ARCH_MXC) += iotdin-imx8p-legacy.dtb
iotdin-imx8p-usbdev-dtbs := iotdin-imx8p.dtb ucm-imx8m-plus-usbdev.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotdin-imx8p-usbdev.dtb
# Overlays
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8plus-gpio-keys.dtbo

# IOT-GATE-IMX8PV2 overlays
## Common
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-hdmi.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-cmd-button.dtbo
## Optional device configuration
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-modem.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-nvme.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-wifi.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-wifi-sdio.dtbo
## User-defined configuration
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-can-a.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-rs485-a.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-can-b.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-rs485-b.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-do0.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-do1.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-do2.dtbo
dtb-$(CONFIG_ARCH_MXC) += iotg-imx8pv2-do3.dtbo

# IOT-GATE-IMX8PV2 device tree
dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8pv2-headless.dtb

iot-gate-imx8pv2-dtbs := iot-gate-imx8pv2-headless.dtb \
		iotg-imx8pv2-hdmi.dtbo

dtb-$(CONFIG_ARCH_MXC) += iot-gate-imx8pv2.dtb
