/********** WiFi/BT **********/
&{/} {
	reg_usdhc2_vsel: regulator-usdhc2-vsel {
		compatible = "regulator-gpio";
		regulator-name = "sd-vsel";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		states = <1800000 0x1 3300000 0x0>;
	};
	usdhc2_pwrseq: usdhc2_pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio5 2 GPIO_ACTIVE_LOW>;
	};
};

&uart4 {
	uart-has-rtscts;
	status = "okay";

	bt_uart: bluetooth {
		compatible = "nxp,88w8987-bt";
		fw-init-baudrate = <3000000>;
	};
};

&usdhc2 {
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	non-removable;
	wakeup-source;
	mmc-pwrseq = <&usdhc2_pwrseq>;
	vqmmc-supply = <&reg_usdhc2_vsel>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	mwifiex: wifi@1 {
		compatible = "marvell,sd8997";
		reg = <1>;
	};
};
/********** WiFi/BT - End **********/

&pcie {
	status = "disabled";
};
&pcie_phy {
	status = "disabled";
};

&pinctrl_uart4 {
	fsl,pins = <
		MX8MP_IOMUXC_UART4_TXD__UART4_DTE_RX				0x140
		MX8MP_IOMUXC_UART4_RXD__UART4_DTE_TX				0x140
		MX8MP_IOMUXC_ECSPI2_MISO__UART4_DTE_RTS				0x140
			MX8MP_IOMUXC_ECSPI2_SS0__UART4_DTE_CTS			0x140
	>;
};

&iomuxc {
	pinctrl_usdhc2_gpio: usdhc2grp-gpio {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO04__GPIO1_IO04			0x100 /* SD2_VSEL */
			MX8MP_IOMUXC_SAI3_MCLK__GPIO5_IO02			0x140 /* WIFI_RSTn */
		>;
	};
};
