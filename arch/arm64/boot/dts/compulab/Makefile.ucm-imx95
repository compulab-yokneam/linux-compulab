DTC_FLAGS := -@

# An old school style -- all included
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-som.dtb
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95.dtb
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-ezurio.dtb

# overlays
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-lvds.dtbo
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-wm8962.dtbo
dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-rpmsg.dtbo

# A modern style -- all overlayed
ucm-imx95-evk-dtbs := ucm-imx95-som.dtb \
		ucm-imx95-lvds.dtbo \
		ucm-imx95-wm8962.dtbo

dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-evk.dtb

ucm-imx95-rpmsg-dtbs := ucm-imx95-som.dtb \
		ucm-imx95-rpmsg.dtbo

dtb-$(CONFIG_ARCH_MXC) += ucm-imx95-rpmsg.dtb
