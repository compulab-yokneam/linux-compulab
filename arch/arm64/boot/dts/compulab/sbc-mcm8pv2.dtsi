/*
 * Copyright 2026 CompuLab
 * SBC-MCM8PV2 rev. 1.0: Ethernet (sheets 4/5), displays (sheet 7),
 * and the I2C3 GPIO expander providing display resets (sheet 10).
 */

/ {
	sbc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	sbc_5v0: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	sbc_lvds_backlight: backlight-lvds {
		compatible = "pwm-backlight";
		power-supply = <&sbc_5v0>;
		pwms = <&pwm2 0 50000 0>;
		brightness-levels = <0 16 32 64 96 128 160 192 224 255>;
		default-brightness-level = <8>;
	};

	sbc_dsi_backlight: backlight-dsi {
		compatible = "pwm-backlight";
		power-supply = <&sbc_3v3>;
		pwms = <&pwm3 0 50000 0>;
		brightness-levels = <0 16 32 64 96 128 160 192 224 255>;
		default-brightness-level = <8>;
	};

	/* Provisional panel timing, matching the existing MCM LVDS setup. */
	sbc_lvds_panel: panel-lvds {
		compatible = "boe,hv070wsa-100";
		power-supply = <&sbc_3v3>;
		enable-gpios = <&sbc_gpio 3 GPIO_ACTIVE_HIGH>;
		backlight = <&sbc_lvds_backlight>;

		port {
			sbc_lvds_in: endpoint {
				remote-endpoint = <&sbc_lvds_out>;
			};
		};
	};
};

/* Carrier-board Ethernet: RTL8211F on the ENET_QOS interface. */
&eqos {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_eqos>;
	phy-mode = "rgmii-id";
	phy-handle = <&sbc_eqos_phy>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		sbc_eqos_phy: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
			reset-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
			reset-assert-us = <15000>;
			reset-deassert-us = <100000>;
			eee-broken-1000t;
			realtek,clkout-disable;
		};
	};
};

/* Carrier-board Ethernet1: KSZ9131 on the ENET1/FEC interface. */
&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_fec>;
	phy-mode = "rgmii-id";
	phy-handle = <&sbc_fec_phy>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * Address 7 confirmed on hardware; schematic annotation says 5.
		 * TBD: to talk to the HW engineer.
		 */
		sbc_fec_phy: ethernet-phy@7 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <7>;
			reset-gpios = <&gpio4 24 GPIO_ACTIVE_LOW>;
			reset-assert-us = <15000>;
			reset-deassert-us = <100000>;
		};
	};
};

&i2c3 {
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_sbc_i2c3>;
	pinctrl-1 = <&pinctrl_sbc_i2c3_gpio>;
	scl-gpios = <&gpio5 18 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio5 19 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	status = "okay";

	sbc_gpio: gpio@20 {
		compatible = "nxp,pca9555";
		vcc-supply = <&sbc_3v3>;
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	eeprom@54 {
		compatible = "atmel,24c08";
		reg = <0x54>;
		pagesize = <16>;
	};
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_pwm2>;
	status = "okay";
};

&pwm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_pwm3>;
	status = "okay";
};

&lcdif1 {
	status = "okay";
};

&mipi_dsi {
	status = "okay";

	/* Same provisional Startek ILI9881C panel as the U-Boot setup. */
	panel@0 {
		compatible = "startek,kd050hdfia020";
		reg = <0>;
		power-supply = <&sbc_3v3>;
		reset-gpios = <&sbc_gpio 2 GPIO_ACTIVE_LOW>;
		dsi-lanes = <4>;
		backlight = <&sbc_dsi_backlight>;

		panel-timing {
			clock-frequency = <60000000>;
			hactive = <720>;
			vactive = <1280>;
			hfront-porch = <10>;
			hback-porch = <10>;
			hsync-len = <10>;
			vfront-porch = <10>;
			vback-porch = <30>;
			vsync-len = <20>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
		};
	};
};

&lcdif2 {
	status = "okay";
};

&ldb {
	status = "okay";

	lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";

		port@1 {
			reg = <1>;
			sbc_lvds_out: endpoint {
				remote-endpoint = <&sbc_lvds_in>;
			};
		};
	};

	lvds-channel@1 {
		status = "disabled";
	};
};

&ldb_phy {
	status = "okay";
};

&iomuxc {
	pinctrl_sbc_eqos: eqosgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ENET_MDC__ENET_QOS_MDC				0x2
			MX8MP_IOMUXC_ENET_MDIO__ENET_QOS_MDIO				0x2
			MX8MP_IOMUXC_ENET_RD0__ENET_QOS_RGMII_RD0			0x90
			MX8MP_IOMUXC_ENET_RD1__ENET_QOS_RGMII_RD1			0x90
			MX8MP_IOMUXC_ENET_RD2__ENET_QOS_RGMII_RD2			0x90
			MX8MP_IOMUXC_ENET_RD3__ENET_QOS_RGMII_RD3			0x90
			MX8MP_IOMUXC_ENET_RXC__CCM_ENET_QOS_CLOCK_GENERATE_RX_CLK	0x90
			MX8MP_IOMUXC_ENET_RX_CTL__ENET_QOS_RGMII_RX_CTL			0x90
			MX8MP_IOMUXC_ENET_TD0__ENET_QOS_RGMII_TD0			0x16
			MX8MP_IOMUXC_ENET_TD1__ENET_QOS_RGMII_TD1			0x16
			MX8MP_IOMUXC_ENET_TD2__ENET_QOS_RGMII_TD2			0x16
			MX8MP_IOMUXC_ENET_TD3__ENET_QOS_RGMII_TD3			0x16
			MX8MP_IOMUXC_ENET_TX_CTL__ENET_QOS_RGMII_TX_CTL			0x16
			MX8MP_IOMUXC_ENET_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK	0x16
			MX8MP_IOMUXC_GPIO1_IO01__GPIO1_IO01				0x10
		>;
	};

	pinctrl_sbc_fec: fecgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXD2__ENET1_MDC		0x2
			MX8MP_IOMUXC_SAI1_RXD3__ENET1_MDIO		0x2
			MX8MP_IOMUXC_SAI1_RXD4__ENET1_RGMII_RD0		0x90
			MX8MP_IOMUXC_SAI1_RXD5__ENET1_RGMII_RD1		0x90
			MX8MP_IOMUXC_SAI1_RXD6__ENET1_RGMII_RD2		0x90
			MX8MP_IOMUXC_SAI1_RXD7__ENET1_RGMII_RD3		0x90
			MX8MP_IOMUXC_SAI1_TXC__ENET1_RGMII_RXC		0x90
			MX8MP_IOMUXC_SAI1_TXFS__ENET1_RGMII_RX_CTL	0x90
			MX8MP_IOMUXC_SAI1_TXD0__ENET1_RGMII_TD0		0x16
			MX8MP_IOMUXC_SAI1_TXD1__ENET1_RGMII_TD1		0x16
			MX8MP_IOMUXC_SAI1_TXD2__ENET1_RGMII_TD2		0x16
			MX8MP_IOMUXC_SAI1_TXD3__ENET1_RGMII_TD3		0x16
			MX8MP_IOMUXC_SAI1_TXD4__ENET1_RGMII_TX_CTL	0x16
			MX8MP_IOMUXC_SAI1_TXD5__ENET1_RGMII_TXC		0x16
			MX8MP_IOMUXC_SAI2_TXFS__GPIO4_IO24		0x10
		>;
	};

	pinctrl_sbc_i2c3: i2c3grp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__I2C3_SCL			0x400001c2
			MX8MP_IOMUXC_I2C3_SDA__I2C3_SDA			0x400001c2
		>;
	};

	pinctrl_sbc_i2c3_gpio: i2c3grp-gpio {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__GPIO5_IO18	0x1c2
			MX8MP_IOMUXC_I2C3_SDA__GPIO5_IO19	0x1c2
		>;
	};

	pinctrl_sbc_pwm2: sbc-pwm2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SPDIF_RX__PWM2_OUT 0x116
		>;
	};

	pinctrl_sbc_pwm3: sbc-pwm3grp {
		fsl,pins = <
			MX8MP_IOMUXC_SPDIF_TX__PWM3_OUT 0x116
		>;
	};
};
