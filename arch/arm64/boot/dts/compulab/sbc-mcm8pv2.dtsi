&{/} {
	sbc_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	sbc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
	sbc_5v0: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_sbc_i2c3>;
	pinctrl-1 = <&pinctrl_sbc_i2c3_gpio>;
	scl-gpios = <&gpio5 18 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio5 19 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	status = "okay";

	sbc_gpio: gpio@20 {
		compatible = "nxp,pca9555";
		vcc-supply = <&sbc_3v3>;
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	eeprom@54 {
		compatible = "atmel,24c08";
		reg = <0x54>;
		pagesize = <16>;
	};
};

/* Sheet 3: P4 micro-SD socket, directly powered from VCC_3V3. */
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sbc_usdhc2>;
	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&sbc_3v3>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	status = "okay";
};

&iomuxc {
	pinctrl_sbc_usdhc2: sbc-usdhc2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK		0x190
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD		0x1d0
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
			MX8MP_IOMUXC_SD2_CD_B__GPIO2_IO12		0x1c4
		>;
	};

	pinctrl_sbc_i2c3: i2c3grp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__I2C3_SCL			0x400001c2
			MX8MP_IOMUXC_I2C3_SDA__I2C3_SDA			0x400001c2
		>;
	};
	pinctrl_sbc_i2c3_gpio: i2c3grp-gpio {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__GPIO5_IO18	0x1c2
			MX8MP_IOMUXC_I2C3_SDA__GPIO5_IO19	0x1c2
		>;
	};
};
