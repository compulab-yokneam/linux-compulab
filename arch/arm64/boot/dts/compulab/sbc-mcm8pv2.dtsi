&{/} {
	sbc_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	sbc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
	sbc_5v0: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "sbc-5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_sbc_i2c3>;
	pinctrl-1 = <&pinctrl_sbc_i2c3_gpio>;
	scl-gpios = <&gpio5 18 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio5 19 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	status = "okay";

	sbc_gpio: gpio@20 {
		compatible = "nxp,pca9555";
		vcc-supply = <&sbc_3v3>;
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	eeprom@54 {
		compatible = "atmel,24c08";
		reg = <0x54>;
		pagesize = <16>;
	};
};

&iomuxc {
	pinctrl_sbc_i2c3: i2c3grp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__I2C3_SCL			0x400001c2
			MX8MP_IOMUXC_I2C3_SDA__I2C3_SDA			0x400001c2
		>;
	};
	pinctrl_sbc_i2c3_gpio: i2c3grp-gpio {
		fsl,pins = <
			MX8MP_IOMUXC_I2C3_SCL__GPIO5_IO18	0x1c2
			MX8MP_IOMUXC_I2C3_SDA__GPIO5_IO19	0x1c2
		>;
	};
};
