# Disable display, GPU/NPU, video/camera, audio and DSP support.
# Merge after compulab_v8_defconfig, optionally after compulab_trim_imx8mp.config.
# Use the lowmem DT overlay as well to release reserved GPU memory.

# GPU and display
# CONFIG_MXC_GPU_VIV is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_IMX_DPU_CORE is not set
# CONFIG_IMX_LCDIFV3_CORE is not set
# CONFIG_MXC_PXP_V3 is not set

# HDMI ARC/eARC transceiver references DRM symbols even with DRM disabled.
# CONFIG_SND_SOC_FSL_XCVR is not set

# HDMI receiver CEC selects a DRM bridge helper.
# CONFIG_VIDEO_MHDP_HDMIRX is not set
# CONFIG_VIDEO_MHDP_HDMIRX_CEC is not set

# Video capture, cameras and codec framework
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING_MEDIA is not set
# CONFIG_MXC_HANTRO_V4L2 is not set
# CONFIG_MXC_VIDEO_HANTRO_DEC is not set
# CONFIG_MXC_VIDEO_HANTRO_ENC is not set
# Disable standalone codec controls too; WAVE6_CTRL selects MXC_MUR.
# CONFIG_MXC_VIDEO_WAVE511_CTRL is not set
# CONFIG_MXC_VIDEO_WAVE6_CTRL is not set
# CONFIG_MXC_MUR is not set

# Audio and audio DSP
# CONFIG_SOUND is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_IMX_DSP is not set
# CONFIG_IMX_DSP_REMOTEPROC is not set
