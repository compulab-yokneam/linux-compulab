# Help: IOT-LINK FIT image device trees and i.MX93 load addresses
CONFIG_FIT_IMAGE=y
CONFIG_FIT_DEVICETREE="compulab/iot-link.dtb compulab/iot-link-ml.dtb compulab/iot-link-cam.dtb compulab/iot-link-fars485.dtbo compulab/iot-link-fbrs485.dtbo compulab/iot-link-facan.dtbo compulab/iot-link-fbcan.dtbo"
CONFIG_UBOOT_LOADADDRESS="0x80400000"
CONFIG_UBOOT_ENTRYPOINT="0x80400000"
CONFIG_UBOOT_DTB_LOADADDRESS="0x93000000"
CONFIG_UBOOT_DTBO_LOADADDRESS="0x93100000"
