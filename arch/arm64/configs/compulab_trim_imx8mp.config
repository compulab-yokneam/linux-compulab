# Trim drivers for hardware not present on CompuLab i.MX8MP systems.
# Merge after compulab_v8_defconfig; retain i.MX8MP multimedia support.

# CompuLab i.MX8MP boots with device tree, not ACPI.
# CONFIG_ACPI is not set

# NVIDIA CPU, GPU, peripheral and network hardware
# CONFIG_NVIDIA_CARMEL_CNP_ERRATUM is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_FB_NVIDIA is not set
# CONFIG_USB_CHIPIDEA_TEGRA is not set
# CONFIG_I2C_NVIDIA_GPU is not set
# CONFIG_HID_NVIDIA_SHIELD is not set
# CONFIG_TYPEC_NVIDIA_ALTMODE is not set
# CONFIG_NET_VENDOR_NVIDIA is not set
# CONFIG_NET_VENDOR_MELLANOX is not set

# Display/GPU hardware from other SoCs
# CONFIG_MALI_MIDGARD is not set
# CONFIG_FB_MXC_EINK_V2_PANEL is not set
# CONFIG_IMX_DPU_CORE is not set
# CONFIG_IMX8MM_LCDIF_CORE is not set

# Video codecs and pixel processors from other SoCs
# CONFIG_VIDEO_AMPHION_VPU is not set
# CONFIG_MXC_VIDEO_CODA980 is not set
# CONFIG_MXC_VIDEO_WAVE511 is not set
# CONFIG_MXC_VIDEO_WAVE511_CTRL is not set
# CONFIG_MXC_VIDEO_WAVE6 is not set
# CONFIG_MXC_VIDEO_WAVE6_CTRL is not set
# CONFIG_MXC_PXP_V3 is not set

# ML accelerators from other SoCs (i.MX8MP uses the Vivante NPU driver)
# CONFIG_ETHOSU is not set
# CONFIG_NEUTRON is not set
# CONFIG_IMX_NEUTRON_REMOTEPROC is not set
